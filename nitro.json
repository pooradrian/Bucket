{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["crypto"],
  "ios": {
    "iosModuleName": "NitroCrypto"
  },
  "android": {
    "androidNamespace": ["crypto"],
    "androidCxxLibName": "NitroCrypto"
  },
  "autolinking": {
    "NativeCrypto": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridNativeCrypto"
      }
    },
    "NativeEmbeddings": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridNativeEmbeddings"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
